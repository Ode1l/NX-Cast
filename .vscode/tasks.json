{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NX-Cast: Clean",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "clean"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev.ps1",
          "clean"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "NX-Cast: Compile",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "build"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev.ps1",
          "build"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
